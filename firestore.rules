rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      // Verification fields (youtubeVerifiedUntil, memberUntil) are written only by Functions/scripts.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'photoURL', 'updatedAt']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'updatedAt'
        ]);
      allow delete: if admin();
    }

    function listedLevel(level) {
      return level in ['public', 'login', 'subscriber', 'member'];
    }

    // Private games are readable only by the verified emails in gameAllowlists/{gameId}.
    function invited(gameId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/gameAllowlists/$(gameId))
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/gameAllowlists/$(gameId)).data.emails;
    }

    match /games/{gameId} {
      allow get: if admin() || (resource.data.buildStatus == 'published'
        && (listedLevel(resource.data.accessLevel) || (resource.data.accessLevel == 'private' && invited(gameId))));
      // Lists must filter out private games; invitees get theirs from the listPrivateGames Function.
      allow list: if admin() || (resource.data.buildStatus == 'published' && listedLevel(resource.data.accessLevel));
      allow write: if admin();
    }

    match /gameAllowlists/{gameId} {
      // Written only by Functions; never readable by invitees, so they cannot see each other's emails.
      allow read: if admin();
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid == resource.data.authorId
        && resource.data.imagePath == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imagePath', 'updatedAt'])
        && request.resource.data.imagePath == 'board-images/' + postId + '/image';
      allow delete: if admin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if false;
    }

    match /likeRecords/{recordId} {
      allow read, write: if false;
    }
  }
}
